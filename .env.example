# 이 파일을 .env.local 로 복사해서 쓴다.  cp .env.example .env.local
#
# Next.js 는 이 디렉터리(FE/)의 .env.local 을 읽는다. 저장소 루트의 .env 는 읽지 않는다.
# 루트 .env 는 docker-compose 와 BE 용이다. 두 파일은 별개다.
#
# ⚠️ NEXT_PUBLIC_ 접두사가 붙은 값은 빌드 결과물에 그대로 박혀서 브라우저로 내려간다.
#    즉 전부 공개된다. 비밀값을 여기 넣지 않는다.
#    게다가 이 프로젝트는 정적 내보내기(output: "export")라서 빌드 시점에 값이 고정된다 —
#    값을 바꾸려면 재빌드해야 한다.

# BE API 주소. 비우면 "화면 확인 단계" — 임시 카탈로그로 돌고 로그인·주문이 닫힌다.
# (이름이 NEXT_PUBLIC_API_BASE 다. 예전 템플릿의 _URL 은 코드가 읽지 않았다.)
# 운영 빌드에서는 상품을 이 API 에서 받으므로, API 가 응답하지 않으면 빌드가 실패한다(lib/catalog.ts).
NEXT_PUBLIC_API_BASE=http://localhost:8080

# 토스페이먼츠 클라이언트 키 (test_ck_… / live_ck_…). 공개 값이라 여기 둬도 된다 — 시크릿 키는 BE 에만.
# 비우면 주문서의 결제 버튼이 "결제 준비 중" 으로 닫힌다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
